---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { buildTranslationIndex } from '../lib/translation-index.mjs';
import { getSections, orderSectionRows } from '../lib/sections.mjs';
import { getZhEntries } from './_zh-entries.mjs';
import { withSiteBase } from '../lib/site-path.mjs';

const sections = getSections();
const articles = await getCollection('articles');
const zhEntries = await getZhEntries();
const rows = buildTranslationIndex(articles, zhEntries);
const translatedCount = rows.filter((row) => row.status === 'current').length;
const path = (value) => withSiteBase(value, import.meta.env.BASE_URL);
---

<BaseLayout title="Algebrica 中文译本">
  <div class="home-page">
    <header class="home-hero">
      <span class="page-kicker">非官方 · 非商业 · 开放阅读</span>
      <h1>一本持续生长的<br />中文数学参考书</h1>
      <p>从集合、代数和几何出发，沿着清晰的章节结构阅读公式、证明、插图与知识图谱。</p>
      <div class="home-hero__stats" aria-label="译本进度">
        <span><strong>{sections.length}</strong> 个分类</span>
        <span><strong>{rows.length}</strong> 篇条目</span>
        <span><strong>{translatedCount}</strong> 篇中文译文</span>
      </div>
    </header>

    <section class="section-index" aria-labelledby="section-index-title">
      <div class="section-index__head">
        <span class="page-kicker">全书目录</span>
        <h2 id="section-index-title">按分类阅读</h2>
      </div>

      {sections.map((section) => {
        const sectionRows = orderSectionRows(section, rows);
        return (
          <section class="section-index__group">
            <header class="section-index__group-head">
              <span class="section-index__number">{String(section.order).padStart(2, '0')}</span>
              <div>
                <h3><a href={path(`/category/${section.dir}/`)}>{section.name_zh}</a></h3>
                <p lang="zh-CN">{section.description_zh}</p>
              </div>
            </header>
            <ol class="section-index__entries">
              {sectionRows.map((row, index) => {
                const title = row.zh?.data.title || row.en.data.title;
                return (
                  <li>
                    <span>{section.order}.{index + 1}</span>
                    <a href={path(`/${row.slug}/`)} lang={row.zh ? 'zh-CN' : 'en'}>{title}</a>
                    {row.status === 'missing' && <small>英文</small>}
                    {row.status === 'stale' && <small>待同步</small>}
                  </li>
                );
              })}
            </ol>
          </section>
        );
      })}
    </section>
  </div>
</BaseLayout>
