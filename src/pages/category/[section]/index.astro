---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { buildTranslationIndex } from '../../../lib/translation-index.mjs';
import { getSections, orderSectionRows } from '../../../lib/sections.mjs';
import { getZhEntries } from '../../_zh-entries.mjs';
import { withSiteBase } from '../../../lib/site-path.mjs';

export async function getStaticPaths() {
  return getSections().map((section) => ({
    params: { section: section.dir },
    props: { section },
  }));
}

const { section } = Astro.props;
const articles = await getCollection('articles');
const zhEntries = await getZhEntries();
const rows = orderSectionRows(section, buildTranslationIndex(articles, zhEntries));
const title = `${section.name_zh} | Algebrica 中文译本`;
const description = section.description_zh;
const path = (value) => withSiteBase(value, import.meta.env.BASE_URL);
---

<BaseLayout title={title}>
  <div class="category-page">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href={path('/')}>全书目录</a><span>/</span><span>{section.name_zh}</span>
    </nav>

    <header class="category-header">
      <span class="page-kicker">第 {section.order} 编 · {rows.length} 篇</span>
      <h1>{section.name_zh}</h1>
      {description && <p lang="zh-CN">{description}</p>}
    </header>

    <section class="category-contents" aria-labelledby="category-contents-title">
      <h2 id="category-contents-title">本编目录</h2>
      <ol class="chapter-list">
        {rows.map((row, index) => {
          const titleText = row.zh?.data.title || row.en.data.title;
          return (
            <li>
              <a href={path(`/${row.slug}/`)}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong lang={row.zh ? 'zh-CN' : 'en'}>{titleText}</strong>
                {row.status === 'missing' && <small>英文原文</small>}
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  </div>
</BaseLayout>
