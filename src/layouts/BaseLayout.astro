---
import SearchBox from '../components/SearchBox.astro';
import '../styles/site.css';
import { withSiteBase } from '../lib/site-path.mjs';

export interface Props {
  lang?: string;
  title?: string;
}
const { lang = 'zh-CN', title = 'Algebrica 中文' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = (value) => withSiteBase(value, base);
---

<!DOCTYPE html>
<html lang={lang} data-theme="white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:," />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('algebrica-theme');
          if (saved === 'black') document.documentElement.dataset.theme = 'black';
        } catch (_) {
          // Storage can be unavailable in local file previews.
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href={path('/')} aria-label="Algebrica 中文译本首页">
          <span class="site-brand__name">Algebrica 中文译本</span>
          <span class="site-brand__tagline">开放数学条目</span>
        </a>

        <nav class="site-nav" aria-label="主导航">
          <a href={path('/')}>章节目录</a>
          <a href={path('/bibliography/')}>参考文献</a>
          <a href={path('/about/')}>关于</a>
          <SearchBox variant="desktop" />
          <div class="theme-switch" role="group" aria-label="黑白主题">
            <button type="button" data-theme-choice="white" aria-pressed="true" title="白色主题">白</button>
            <button type="button" data-theme-choice="black" aria-pressed="false" title="黑色主题">黑</button>
          </div>
        </nav>

        <details class="site-menu">
          <summary aria-label="展开导航"><span></span><span></span><span></span></summary>
          <div class="site-menu__panel">
            <SearchBox variant="mobile" />
            <a href={path('/')}>章节目录</a>
            <a href={path('/bibliography/')}>参考文献</a>
            <a href={path('/editorial-process/')}>编辑流程</a>
            <a href={path('/about/')}>关于</a>
            <div class="theme-switch" role="group" aria-label="黑白主题">
              <button type="button" data-theme-choice="white" aria-pressed="true">白色</button>
              <button type="button" data-theme-choice="black" aria-pressed="false">黑色</button>
            </div>
          </div>
        </details>
      </div>
    </header>

    <main id="main-content" class="site-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <span>Algebrica 中文译本 · 非官方、非商业项目</span>
      <span>内容遵循 <a href="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a></span>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const buttons = Array.from(document.querySelectorAll('[data-theme-choice]'));

        function setTheme(theme, persist = true) {
          const next = theme === 'black' ? 'black' : 'white';
          root.dataset.theme = next;
          buttons.forEach((button) => {
            button.setAttribute('aria-pressed', String(button.dataset.themeChoice === next));
          });
          if (persist) {
            try { localStorage.setItem('algebrica-theme', next); } catch (_) {}
          }
        }

        setTheme(root.dataset.theme, false);
        buttons.forEach((button) => {
          button.addEventListener('click', () => setTheme(button.dataset.themeChoice));
        });
      })();
    </script>
  </body>
</html>
