---
import { layoutArticleGraph } from '../lib/article-graph.mjs';

const { graph } = Astro.props;
const layout = graph ? layoutArticleGraph(graph.dataset, { height: graph.canvasHeight }) : null;
const difficultyDots = [1, 2, 3, 4];
---

{graph && layout && (
  <section class="article-graph" aria-labelledby="article-graph-title">
    <header class="article-graph__header">
      <div>
        <span class="page-kicker">概念结构</span>
        <h2 id="article-graph-title">知识图谱</h2>
        <p>{graph.description}</p>
      </div>
      <strong>{layout.nodes.length} 个概念</strong>
    </header>

    <div class="article-graph__scroll" tabindex="0" aria-label="知识图谱，可横向滚动">
      <div class="article-graph__layout" style={`height:${graph.canvasHeight}px`}>
        <div class="article-graph__canvas" style={`height:${graph.canvasHeight}px`}>
          <svg
            viewBox={`0,0,798,${graph.canvasHeight}`}
            width="798"
            height={graph.canvasHeight}
            role="img"
            aria-label="本文概念之间的关系"
            preserveAspectRatio="xMinYMid meet"
          >
            <g aria-hidden="true">
              {layout.links.map((link) => <path class="article-graph__link" d={link.path} />)}
            </g>
            <g>
              {layout.nodes.map((node) => (
                <g class="article-graph__node" transform={`translate(${node.x},${node.y})`}>
                  <circle r={node.children.length > 0 ? 3 : 2.5} />
                  <text x="10" dy="0.32em" text-anchor="start">{node.name}</text>
                </g>
              ))}
            </g>
          </svg>
        </div>
        <aside class="article-graph__meta" aria-label="知识图谱资料">
          <span class="article-graph__meta-kicker">知识图谱</span>
          <strong>{graph.type}</strong>
          <p>{graph.description}</p>
          <div class="article-graph__difficulty" aria-label={`难度：${graph.difficulty.label}`}>
            {difficultyDots.map((dot) => (
              <span class:list={['article-graph__dot', dot <= graph.difficulty.level && 'is-active']}></span>
            ))}
            <span>{graph.difficulty.label}</span>
          </div>
          <dl>
            <div><dt>先修</dt><dd>{graph.requires}</dd></div>
            <div><dt>后续</dt><dd>{graph.enables}</dd></div>
          </dl>
        </aside>
      </div>
    </div>
  </section>
)}
